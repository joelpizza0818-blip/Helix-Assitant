{
  "name": "helix-assistant",
  "version": "1.0.0",
  "description": "HELIX - Persistent Windows AI desktop agent",
  "private": true,
  "workspaces": [
    "apps/desktop",
    "apps/desktop-tauri",
    "apps/landing",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "dev:desktop-electron": "node scripts/dev-desktop.mjs",
    "dev:desktop-tauri": "npm run tauri --workspace=@helix/desktop-tauri -- dev",
    "dev:landing": "npm run dev --workspace=@helix/landing",
    "dev:server": "npm run dev --workspace=@helix/server",
    "build": "npm run build --workspaces",
    "build:desktop": "npm run build --workspace=@helix/desktop",
    "build:desktop-tauri": "npm run build:agent-runtime && npm run tauri --workspace=@helix/desktop-tauri -- build",
    "build:agent-runtime": "powershell -ExecutionPolicy Bypass -File scripts/build-agent-runtime.ps1",
    "stage:windows-installer": "node scripts/stage-windows-installer.mjs",
    "build:windows": "npm run build:agent-runtime && npm run build:desktop && npm run stage:windows-installer && npm run build:landing",
    "build:landing": "npm run build --workspace=@helix/landing",
    "build:server": "npm run build --workspace=@helix/server",
    "models:generate": "node scripts/generate-model-catalog.mjs",
    "models:check": "node scripts/generate-model-catalog.mjs --check",
    "test": "npm run models:check && npm run test --workspaces --if-present && npm run test:agent",
    "test:agent": "python -m pytest services/agent/tests/ -v"
  }
}
