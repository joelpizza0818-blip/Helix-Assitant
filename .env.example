ANTHROPIC_API_KEY_2=
ANTHROPIC_API_KEY_3=

# Google Keys
GOOGLE_API_KEY_1=
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/helix
DIRECT_URL=postgresql://user:password@localhost:5432/helix

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# API URLs
RENDER_API_URL=
VITE_API_URL=http://localhost:3001

# Voice & TTS
VOICE_PROVIDER=openai
VOICE_MODEL=whisper-1
TTS_PROVIDER=openai
TTS_MODEL=tts-1
WAKE_WORD=helix
WAKE_WORD_PROVIDER=openwakeword
PICOVOICE_ACCESS_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Perception / Camera
CAMERA_ENABLED=false
CAMERA_DEVICE_INDEX=0
GESTURE_SENSITIVITY=0.8
VISION_PROVIDER=mediapipe

# Agent / Application
VOICE_ENABLED=true
START_WITH_WINDOWS=true
AGENT_WS_PORT=8765
ELECTRON_DEV_MODE=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/helix.log

# Security
SECRET_ENCRYPTION_KEY=
