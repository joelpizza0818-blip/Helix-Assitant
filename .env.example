# Precedence: env file -> process env -> saved settings.json

# OpenAI Keys
OPENAI_API_KEY_1=
OPENAI_API_KEY_2=
OPENAI_API_KEY_3=

# Anthropic Keys
ANTHROPIC_API_KEY_1=
ANTHROPIC_API_KEY_2=
ANTHROPIC_API_KEY_3=

# Google Keys
GOOGLE_API_KEY_1=
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=

# Database
# Optional, dedicated database for local semantic conversation memory.
# Do not reuse the backend/service database URL for private conversation data.
HELIX_MEMORY_DATABASE_URL=
DATABASE_URL=postgresql://user:password@localhost:5432/helix
DIRECT_URL=postgresql://user:password@localhost:5432/helix

# Landing / Auth (Supabase + GitHub OAuth)
# Configure GitHub provider in Supabase Dashboard > Authentication > Providers
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Private installer repository access for local admin release verification.
GITHUB_INSTALLER_OWNER=
GITHUB_INSTALLER_REPO=
GITHUB_INSTALLER_TOKEN=

# API URLs
RENDER_API_URL=
VITE_API_URL=http://localhost:3001

# Voice & TTS
STT_PROVIDER=whisper_local
STT_MODEL=base
TTS_PROVIDER=system
TTS_MODEL=tts-1
WAKE_WORD=hey helix
WAKE_WORD_PROVIDER=openwakeword
WAKE_WORD_MODEL_PATH=models/wakeword/hey_helix.onnx
WAKE_WORD_THRESHOLD=0.03
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Perception / Camera
CAMERA_ENABLED=true
CAMERA_DEVICE_INDEX=0
GESTURE_SENSITIVITY=0.8
GESTURE_CONFIDENCE_THRESHOLD=0.8
GESTURE_STABILITY_FRAMES=4
GESTURE_COOLDOWN_SECONDS=2.0
VISION_PROVIDER=mediapipe

# Agent / Application
VOICE_ENABLED=true
START_WITH_WINDOWS=true
AGENT_WS_PORT=8765
ELECTRON_DEV_MODE=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/helix.log

# Security
SECRET_ENCRYPTION_KEY=
