{
  "manifest_version": 3,
  "name": "HELIX Desktop Companion",
  "version": "1.0.0",
  "description": "Share the active Chrome or Edge page DOM with your local HELIX desktop agent.",
  "permissions": [
    "alarms",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:47831/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "HELIX DOM Companion"
  }
}
