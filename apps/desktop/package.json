{
  "name": "@helix/desktop",
  "version": "0.8.0",
  "description": "HELIX - Persistent Windows AI desktop agent",
  "author": "HELIX Team",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "dev:all": "vite",
    "build": "node ../../scripts/write-capability-config.mjs && tsc -p tsconfig.main.json && vite build && electron-builder --publish never",
    "preview": "vite preview",
    "test": "cross-env TS_NODE_PROJECT=tsconfig.test.json node --test --test-force-exit --require ts-node/register renderer/src/components/FloatingUI/mentionAutocomplete.test.ts renderer/src/components/FloatingUI/skillMentions.test.ts renderer/src/components/FloatingUI/floatingInputBehavior.test.ts renderer/src/components/FloatingUI/taskExecutionSummary.test.ts renderer/src/components/FloatingUI/attachmentFiles.test.ts renderer/src/components/Toolbox/sections/MCPSection.test.ts renderer/src/components/Toolbox/sections/ComputerSection.test.ts renderer/src/components/Toolbox/sections/developerTerminalInput.test.ts renderer/src/hooks/conversationHistory.test.ts electron/websocket-auth.test.ts electron/browser-extension-bridge.test.ts electron/capability-manager.test.ts electron/media-permissions.test.ts electron/mobile-relay-client.test.ts electron/gesture-window-sequence.test.ts electron/developer-terminal.test.ts",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@supabase/supabase-js": "^2.117.3",
    "@uiw/react-codemirror": "^4.25.12",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tldts": "^7.4.19",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^7.0.3",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0",
    "vite": "^7.3.7",
    "vite-plugin-electron": "^1.2.0",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "build": {
    "electronVersion": "45.2.3",
    "npmRebuild": false,
    "appId": "com.helix.agent",
    "productName": "HELIX",
    "protocols": [
      {
        "name": "HELIX sign-in",
        "schemes": [
          "helix"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "HELIX-Setup-${version}.${ext}",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://zqjktbpymrfjmggjmbfp.supabase.co/functions/v1/installer-updates/"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HELIX",
      "runAfterFinish": true
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../../services/agent",
        "to": "services/agent",
        "filter": [
          "**/*",
          "!.venv/**",
          "!__pycache__/**",
          "!*.pyc",
          "!tests/**",
          "!script.py",
          "!get_quiz.py"
        ]
      },
      {
        "from": "agent-runtime",
        "to": "agent-runtime",
        "filter": [
          "**/*",
          "!.gitkeep"
        ]
      },
      {
        "from": "capability-config.json",
        "to": "capability-config.json"
      },
      {
        "from": "browser-extension",
        "to": "browser-extension",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
